{
  "name": "chunzhang-personal-homepage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chunzhang Liu's vanilla HTML, CSS, and JavaScript personal homepage.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "16.4.0",
    "prettier": "3.6.2"
  },
  "prettier": {
    "endOfLine": "lf",
    "trailingComma": "es5",
    "singleQuote": false
  }
}
